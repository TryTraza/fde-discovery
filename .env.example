# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/clients
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/clients

# Database — Neon Postgres
# DATABASE_URL: direct (unpooled) URL — used by drizzle-kit for migrations.
# DATABASE_POOLED_URL: pooled URL (-pooler hostname) — used by the app at runtime.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.neon.tech/neondb?sslmode=require
DATABASE_POOLED_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.neon.tech/neondb?sslmode=require

# Vercel Blob (artifact file storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Per-feature gateway routing (Bloque 2.9 → Bloque 3).
# Comma-separated list of feature slugs that should be served by
# TrazaAIGateway instead of LocalAIGateway. Use the literal "all" to
# route every feature. Unset (default) keeps everything local.
# Valid slugs: email-draft, session-interview, process-hypothesis,
# prep-brief, capture-suggestions, refresh-company-profile,
# session-synthesis, shadowing-synthesis. (research-chat is SSE and
# stays local until the gateway-streaming design lands in Bloque 3.)
# AI_GATEWAY_TRAZA=
